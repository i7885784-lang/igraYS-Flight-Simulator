+  p.su27CanopyTarget=e.target;p.su27Canopy=slew(e.canopy,e.target,.4);p.su27ThrustFactor=(p.su27SpoolLeft*p.su27SpoolLeft+p.su27SpoolRight*p.su27SpoolRight)*.5;
+ }
