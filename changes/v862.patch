+bool BalanceLevelAirborneStart(FsAirplane &air)
+{
+ auto &p=air.Prop();
+ YsVec3 velocity;p.GetVelocity(velocity);
+ // Only a fresh, neutral, level airborne start. Ground starts, helicopters,
+ // intentional climbs/banks and already-trimmed saved flights keep their setup.
+ if(p.GetAircraftClass()==FSCL_HELICOPTER || p.IsOnGround()==YSTRUE ||
+    p.GetVelocity()<20.0 || YsAbs(air.GetAttitude().p())>YsDegToRad(0.5) ||
+    YsAbs(air.GetAttitude().b())>YsDegToRad(0.5) || YsAbs(velocity.y())>0.5 ||
+    YsAbs(p.GetElvTrim())>0.001 || YsAbs(p.GetElevator())>0.001)return false;
+ p.RefreshAirData(); // Refresh density at the actual starting altitude before balancing lift.
+ const double speed=p.GetVelocity();
+ const double weight=p.GetTotalWeight()*FsGravityConst;
+ double low=-p.GetCriticalAOA()*0.2,high=p.GetCriticalAOA()*0.7;
+ // Level lift includes the upward component of engine thrust.
+ auto lift=[&](double a){return p.GetLift(a,speed)+p.GetDrag(a,speed)*tan(a);};
+ if(lift(low)>weight || lift(high)<weight)return false;
+ for(int i=0;i<32;++i){const double mid=(low+high)*0.5;if(lift(mid)<weight)low=mid;else high=mid;}
+ const double aoa=(low+high)*0.5;
+ const double trim=p.ComputeElevatorTrimForAOA(aoa);
+ if(YsAbs(trim)>0.85)return false;
+ const double requiredThrust=p.GetDrag(aoa,speed)/cos(aoa);
+ // Use thrust at this altitude rather than the sea-level rating.
+ if(p.GetThrust(1.0,air.GetPosition().y(),speed,YSFALSE)<requiredThrust)return false;
+ low=0.0;high=1.0;
+ for(int i=0;i<32;++i){const double mid=(low+high)*0.5;if(p.GetThrust(mid,air.GetPosition().y(),speed,YSFALSE)<requiredThrust)low=mid;else high=mid;}
+ const double throttle=(low+high)*0.5;
+ YsString command;
+ // Preserve position and horizontal velocity; pitch supplies the 1G angle of attack.
+ command.Printf("ATTITUDE %.9fdeg %.9fdeg 0deg",YsRadToDeg(air.GetAttitude().h()),YsRadToDeg(aoa));air.SendCommand(command);
+ p.SetElvTrim(trim);p.SetThrottle(throttle);p.SetAfterburner(YSFALSE);
+ printf("V862BALANCE id=%d speed=%.4f pitch=%.4f trim=%.6f throttle=%.6f\n",air.ysfId,speed,YsRadToDeg(aoa),trim,throttle);
+ return true;
+}
