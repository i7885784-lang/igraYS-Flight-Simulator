+void FsAirplaneProperty::UpdateExternalMechanisms(double dt)
+{
+    if(dt<=0.0) return;
+    auto approach=[dt](double &value,double target,double rate)
+    { value+=YsBound(target-value,-rate*dt,rate*dt); };
+    // Visual approximation of variable-area exhaust: open at idle, narrower
+    // at maximum dry thrust, open again on afterburner. This is not an EEC model.
+    const double dry=YsBound((staThrottle-.08)/.92,0.0,1.0);
+    const double target=(YSTRUE==staAb ? .88+.12*staThrottle : 1.0-.83*dry);
+    approach(staNozzleOpening,target,.9);
+    if(0==strcmp(GetIdentifier(),"MIG-29_FULCRUM"))
+    {
+        const bool running=(GetFuelLeft()>0.0 && IsActive()==YSTRUE && (!su27Managed || YsGreater(su27SpoolLeft,su27SpoolRight)>.08));
+        if(YSTRUE!=IsOnGround() || !running || GetVelocity()>57.0) intakeProtectionCommand=false;
+        else if(GetVelocity()<54.0) intakeProtectionCommand=true;
+        // Around 200 km/h, with hysteresis to prevent switch chatter.
+        approach(staIntakeProtection,intakeProtectionCommand?1.0:0.0,.85);
+        const double demand=running ? staIntakeProtection*(.55+.40*staThrottle) : 0.0;
+        approach(staAuxIntakeOpening,demand,1.2);
+    }
 }
 
