+YsVisualDnm::Shell &YsVisualDnm::RenderShell(Dnm::Node *node) const
+{
+    if(!componentDiagnostic) return *node;
+    auto &cached=diagnosticShells[node];
+    if(!cached)
+    {
+        cached=std::make_shared<Shell>();
+        static_cast<YsShellExt &>(*cached)=static_cast<const YsShellExt &>(*node);
+        unsigned int hash=2166136261u;
+        for(const char *p=node->nodeName.Txt();*p;++p) hash=(hash^static_cast<unsigned char>(*p))*16777619u;
+        // Stable hue per named mechanism. Preserve opacity, normal and lighting.
+        const double hue=(hash%360)*YsPi/180.0;
+        for(auto plHd : cached->AllPolygon())
+        {
+            auto col=cached->GetColor(plHd);
+            const double alpha=col.Ad();
+            col.SetDoubleRGB(.57+.36*cos(hue),.57+.36*cos(hue-2.0*YsPi/3.0),.57+.36*cos(hue+2.0*YsPi/3.0));
+            col.SetAd(alpha);
+            cached->SetPolygonColor(plHd,col);
+        }
+    }
+    return *cached;
+}
